    "firefox.exe":         {"category": "browser",  "label": "Mozilla Firefox",    "document": "url", "note": "moteur Gecko, lecture d'URL NON testee au 31/08 : s'abstiendra si l'omnibox n'est pas exposee"},

    "olk.exe":             {"category": "mail",     "label": "Outlook",            "document": "title"},
    "outlook.exe":         {"category": "mail",     "label": "Outlook classique",  "document": "title"},
    "thunderbird.exe":     {"category": "mail",     "label": "Thunderbird",        "document": "title"},

    "code.exe":            {"category": "editor",   "label": "VS Code",            "document": "title"},
    "cursor.exe":          {"category": "editor",   "label": "Cursor",             "document": "title"},
    "notepad.exe":         {"category": "editor",   "label": "Bloc-notes",         "document": "title"},
    "notepad++.exe":       {"category": "editor",   "label": "Notepad++",          "document": "title"},
    "devenv.exe":          {"category": "editor",   "label": "Visual Studio",      "document": "title"},

    "windowsterminal.exe": {"category": "terminal", "label": "Windows Terminal",   "document": null},
